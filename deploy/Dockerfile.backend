FROM python:3.11-slim

# Non-root user
RUN groupadd -r pramana && useradd -r -g pramana -d /app -s /sbin/nologin pramana

WORKDIR /app

# WeasyPrint native dependencies (Pango, Cairo, GDK-Pixbuf)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libcairo2 \
    libgdk-pixbuf2.0-0 \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps (pinned with hashes in production)
COPY backend/pyproject.toml backend/
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e "backend/[dev]"

# Copy source
COPY backend/src /app/src
COPY models /app/models

ENV PYTHONPATH=/app/src
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

USER pramana

EXPOSE 8000

CMD ["uvicorn", "pramana.bootstrap.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
