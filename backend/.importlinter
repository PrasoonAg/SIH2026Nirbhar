[importlinter:contract:r7_baseline_mapping_spec_is_pure]
name = R7 baseline.mapping_spec is pure (stdlib + pydantic only)
type = forbidden
source_modules =
    pramana.baseline.domain.mapping_spec
forbidden_modules =
    sqlalchemy
    fastapi
    torch
    sentence_transformers
    pygit2
