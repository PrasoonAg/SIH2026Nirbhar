forbidden_modules =
    sqlalchemy
    fastapi
    torch
    sentence_transformers
    pygit2
    weasyprint
    httpx
    pramana.identity
    pramana.ledger
    pramana.baseline
    pramana.crypto
    pramana.parsing
    pramana.proposer
    pramana.trustgate
    pramana.profiles
    pramana.compliance
