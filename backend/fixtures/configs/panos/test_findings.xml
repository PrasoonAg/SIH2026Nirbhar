<?xml version="1.0" encoding="utf-8"?>
<!-- PAN-OS findings fixture: telnet-equiv mgmt access, SNMP public, no NTP, HTTP mgmt -->
<config version="11.0.0">
  <devices>
    <entry name="localhost.localdomain">
      <deviceconfig>
        <system>
          <hostname>fw-findings-01</hostname>
          <domain>lab.example.com</domain>
          <!-- SNMP with default community -->
          <snmp-setting>
            <access-setting>
              <version>
                <v2c>
                  <snmp-community-string>public</snmp-community-string>
                </v2c>
              </version>
            </access-setting>
          </snmp-setting>
          <!-- No NTP configured -->
          <!-- No syslog configured -->
        </system>
      </deviceconfig>
      <vsys>
        <entry name="vsys1">
          <rulebase>
            <security>
            </security>
          </rulebase>
        </entry>
      </vsys>
      <network>
        <interface>
          <ethernet>
            <entry name="ethernet1/1">
              <layer3>
                <units>
                  <entry name="ethernet1/1.1">
                    <ip>
                      <entry name="10.0.0.1/24"/>
                    </ip>
                  </entry>
                </units>
              </layer3>
            </entry>
          </ethernet>
        </interface>
        <profiles>
          <interface-management-profile>
            <entry name="MGMT-INSECURE">
              <!-- HTTP and telnet allowed — violation -->
              <http>yes</http>
              <telnet>yes</telnet>
              <ssh>yes</ssh>
              <ping>yes</ping>
            </entry>
          </interface-management-profile>
        </profiles>
      </network>
    </entry>
  </devices>
</config>
